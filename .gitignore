# ── 舊程式碼不追蹤 ──
nationalpark/

# ── OneDrive 衝突備份檔 ──
* - 複製.rp
* - 複本.rp
*-conflict*.rp
*.tmp
* - 複製.*
*-LAPTOP-*

# ── Axure RP 自動產生 ──
*.rpprj/
*.rp.bak

# ── OS / 工具 ──
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# ── Python / Node 產物 ──
__pycache__/
*.pyc
node_modules/
.env
.env.local
*.log

# ── Agent 工具與暫存 ──
.claude/
.agent/
temp/
# .scratch 是 junction，指向 D:\scratch-dirs\登山一站式，不進版控
.scratch/

# ── Obsidian：00_Obsidian/ 全部不進版控 ──
#   tasks/、wbs/ 是指向 D 槽共用知識庫的 junction（卡片實體在知識庫，跨專案共用），
#   attachments/、Excalidraw/ 是本機 vault 用的附件與畫布。
#   *.base 是本地檢視設定。2026-08-21 起舊名「看板」改為 tasks，兩種名稱都擋。
00_Obsidian/
# vault 設定由 00_Obsidian-共用設定 的 Sync-ObsidianConfig.ps1 管理，不進版控
.obsidian/
*.base
#   schema.base 例外：它是 03_Schema 的資料表結構檢視，屬專案交付資產，不是個人看板。
!schema.base

# Claudian（Obsidian 外掛）：帳號設定由 00_Obsidian-共用設定 管理，對話紀錄各 vault 自留
.claudian/
# Link-ObsidianConfig.ps1 建立連結前的原檔備份
.obsidian-link-backup/
